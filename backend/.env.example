PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/palacio_gamer
# Opcional si el DNS local bloquea consultas SRV de MongoDB
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=reemplaza_este_valor_por_un_secreto_seguro
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Usadas solo por npm.cmd run seed
SEED_ADMIN_NAME=Administrador Palacio Gamer
SEED_ADMIN_EMAIL=admin@palaciogamer.com
SEED_ADMIN_PASSWORD=cambia_esta_contrasena
SEED_SUPPORT_NAME=Soporte Palacio Gamer
SEED_SUPPORT_EMAIL=soporte@palaciogamer.com
SEED_SUPPORT_PASSWORD=cambia_esta_contrasena
